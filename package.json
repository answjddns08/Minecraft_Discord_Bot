{
	"name": "mc-bot-workspace",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"bot",
		"web"
	],
	"scripts": {
		"dev:bot": "cd bot && npm run dev",
		"dev:server": "cd server && go run ./cmd/api",
		"dev:web": "cd web && npm run dev",
		"build:server": "cd server && go build -o bin/server ./cmd/api",
		"build:web": "cd web && npm run build",
		"docker:up": "docker-compose -f docker-compose.full.yml up -d",
		"docker:down": "docker-compose -f docker-compose.full.yml down",
		"docker:logs": "docker-compose -f docker-compose.full.yml logs -f"
	},
	"devDependencies": {},
	"description": "Minecraft Server Manager - Discord Bot + Web Dashboard"
}
